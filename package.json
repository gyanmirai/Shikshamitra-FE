{
  "name": "Shikshamitra",
  "author": "Shikshamitra",
  "version": "6.0.1",
  "description": "Next Starter & TypeScript",
  "private": true,
  "homepage": "/dashboard",
  "scripts": {
    "dev": "npm install && next dev --turbopack",
    "dev:local": "node --use-system-ca node_modules/next/dist/bin/next dev --webpack",
    "start": "next start",
    "build": "next build --webpack",
    "build:window": "build-and-copy.bat",
    "build:linux": "./build-and-copy.sh",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "docs:check": "node scripts/docs/validate-docs.mjs --all-modules",
    "docs:hr:check": "node scripts/docs/validate-hr-docs.mjs",
    "enrollment:modularity:check": "node scripts/enrollment/check-enrollment-modularity.mjs",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "yarn rm:all && yarn install && yarn dev",
    "re:build": "yarn rm:all && yarn install && yarn build",
    "re:build-npm": "npm run rm:all && npm install && npm run build",
    "dev:ts": "yarn dev & yarn ts:watch",
    "ts": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit --incremental",
    "ts:watch": "yarn ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:dashboard": "node --require ./src/test/patch-vite-windows-net-use.cjs ./node_modules/vitest/vitest.mjs run dashboard --pool=threads",
    "lint:dashboard": "eslint \"src/screens/mainDashboard/**/*.{ts,tsx}\" \"src/redux/**/*dashboard*.ts\" \"e2e/dashboard/**/*.ts\" --quiet",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:permissions": "playwright test --grep @permission",
    "test:e2e:tenant": "playwright test --grep @tenant",
    "test:e2e:accessibility": "playwright test --grep @accessibility",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:report": "playwright show-report",
    "test:e2e:coverage": "node scripts/generate-test-coverage.mjs",
    "test:e2e:bugs": "node scripts/generate-bug-reports.mjs",
    "test:e2e:all-reports": "node scripts/generate-all-test-reports.mjs",
    "test:e2e:student-crm": "node scripts/e2e/run-student-crm-playwright.mjs",
    "test:e2e:student-crm:preflight": "node scripts/e2e/run-student-crm-playwright.mjs --preflight-only",
    "test:e2e:student-crm:dry-run": "node scripts/e2e/run-student-crm-playwright.mjs --dry-run",
    "test:e2e:dashboard": "playwright test e2e/dashboard --output=test-results-dashboard",
    "test:e2e:academic": "playwright test e2e/academic --output=test-results-academic",
    "test:e2e:academic:smoke": "playwright test e2e/academic/academic-smoke.spec.ts --output=test-results-academic-smoke",
    "test:e2e:academic:critical": "playwright test e2e/academic --grep @critical --output=test-results-academic-critical",
    "test:e2e:academic:permissions": "playwright test e2e/academic --grep @permission --output=test-results-academic-permissions",
    "test:e2e:academic:tenant": "playwright test e2e/academic --grep @tenant --output=test-results-academic-tenant",
    "test:e2e:academic:accessibility": "playwright test e2e/academic --grep @accessibility --output=test-results-academic-accessibility",
    "test:e2e:academic:qa": "playwright test e2e/academic/academic-qa-signoff.spec.ts --output=test-results-academic-qa",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "start:out": "npx serve@latest out -p 8083",
    "prepare": "husky install",
    "prepush-check": "node -e \"console.log('Skipping heavy pre-push checks. Use npm run prepush-check:full when needed.')\"",
    "prepush-check:full": "npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
