{
  "compilerOptions": {
    "skipLibCheck": true,
    "paths": {
      "*": [
        "./*"
      ]
    },
    "target": "es2015",
    "lib": [
      "dom",
      "esnext",
      "dom.iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "incremental": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "build/types/**/*.ts",
    "build/dev/types/**/*.ts",
    ".artifacts/permission-inheritance/next-build/types/**/*.ts",
    ".artifacts/permission-inheritance/next-build/dev/types/**/*.ts",
    ".artifacts/host-tenant-next/types/**/*.ts",
    ".artifacts/host-tenant-next/dev/types/**/*.ts",
    ".artifacts/onboarding-next/types/**/*.ts",
    ".artifacts/onboarding-next/dev/types/**/*.ts",
    "build-receipt-grouping-browser/types/**/*.ts",
    "build-receipt-grouping-browser/dev/types/**/*.ts",
    ".artifacts/academic-module-setup/next/types/**/*.ts",
    ".artifacts/academic-module-setup/next/dev/types/**/*.ts",
    ".artifacts/receipt-split-e2e-next/types/**/*.ts",
    ".artifacts/receipt-split-e2e-next/dev/types/**/*.ts",
    ".artifacts/finance-live-next/types/**/*.ts",
    ".artifacts/finance-live-next/dev/types/**/*.ts",
    ".artifacts/finance-none-browser-next/types/**/*.ts",
    ".artifacts/finance-none-browser-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".artifacts",
    "artifacts",
    "tmp",
    "**/route.ts",
    "**/overview/page.ts",
    "dist",
    "build",
    "build-*"
  ]
}
