    {"id":"detail-panel","type":"rectangle","x":1200,"y":145,"width":470,"height":1270,"angle":0,"strokeColor":"#cbd5e1","backgroundColor":"#f8fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":300,"version":1,"versionNonce":300,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
