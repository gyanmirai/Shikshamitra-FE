    {"id":"detail-1","type":"text","x":1230,"y":235,"width":400,"height":165,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":302,"version":1,"versionNonce":302,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"1 · ADMIN SETUP\nAdmin screens:\n• Cycles → offerings\n• Workflow builder → stages + transitions\n• Form builder → sections + fields\n\nPublish makes the selected workflow and forms\nusable by runtime applications.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1 · ADMIN SETUP\nAdmin screens:\n• Cycles → offerings\n• Workflow builder → stages + transitions\n• Form builder → sections + fields\n\nPublish makes the selected workflow and forms\nusable by runtime applications.","autoResize":true,"lineHeight":1.25},
    {"id":"detail-2","type":"text","x":1230,"y":430,"width":400,"height":185,"angle":0,"strokeColor":"#166534","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":303,"version":1,"versionNonce":303,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"2 · INQUIRY + APPLICANT\nCounselor creates an inquiry with source and\ncontact data. Backend checks duplicate phone,\nemail, applicant name, and date of birth.\n\nThe result links family, guardian, applicant,\ninquiry number, activities, and status.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2 · INQUIRY + APPLICANT\nCounselor creates an inquiry with source and\ncontact data. Backend checks duplicate phone,\nemail, applicant name, and date of birth.\n\nThe result links family, guardian, applicant,\ninquiry number, activities, and status.","autoResize":true,"lineHeight":1.25},
    {"id":"detail-3","type":"text","x":1230,"y":645,"width":400,"height":185,"angle":0,"strokeColor":"#5b21b6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":304,"version":1,"versionNonce":304,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"3 · APPLICATION DRAFT\nApplicant 360 starts an application for an\nactive offering. The backend freezes published\nworkflow/form versions and prefills approved\nbindings and defaults.\n\nThe applicant edits fields and saves drafts\nwith concurrency protection.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3 · APPLICATION DRAFT\nApplicant 360 starts an application for an\nactive offering. The backend freezes published\nworkflow/form versions and prefills approved\nbindings and defaults.\n\nThe applicant edits fields and saves drafts\nwith concurrency protection.","autoResize":true,"lineHeight":1.25},
    {"id":"detail-4","type":"text","x":1230,"y":860,"width":400,"height":185,"angle":0,"strokeColor":"#9a3412","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":305,"version":1,"versionNonce":305,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"4 · SUBMIT + PROGRESS\nSubmit runs authoritative required, visibility,\nlength, regex, email, phone, numeric, and date\nvalidation. Invalid fields return field errors.\n\nValid submission advances the workflow and\nupdates stage progress and the timeline.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4 · SUBMIT + PROGRESS\nSubmit runs authoritative required, visibility,\nlength, regex, email, phone, numeric, and date\nvalidation. Invalid fields return field errors.\n\nValid submission advances the workflow and\nupdates stage progress and the timeline.","autoResize":true,"lineHeight":1.25},
    {"id":"detail-ownership","type":"text","x":1230,"y":1075,"width":400,"height":145,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":306,"version":1,"versionNonce":306,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"OWNERSHIP\nFrontend: routes, screens, loading/error/empty\nstates, field rendering, cache refresh.\nBackend: tenant isolation, permissions, rules,\nversion freezing, persistence, audit activities.","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OWNERSHIP\nFrontend: routes, screens, loading/error/empty\nstates, field rendering, cache refresh.\nBackend: tenant isolation, permissions, rules,\nversion freezing, persistence, audit activities.","autoResize":true,"lineHeight":1.25},
